// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BadgeVariant {
  FREE    @map("free")
  PAID    @map("paid")
  PREMIUM @map("premium")
}

enum CardCategory {
  APPS         @map("APPS")
  TOOLS        @map("TOOLS")
  BRUSH        @map("BRUSH")
  TEMPLATE     @map("TEMPLATE")
  ICON         @map("ICON")
  ART_FOR_SELL @map("ART FOR SELL")
  OTHERS       @map("OTHERS")
}

/// Card / Digital Asset table
model DigitalAsset {
  id           String       @id @default(cuid())
  title        String
  thumbnail    String
  banner       String
  icon         String
  badge        BadgeVariant
  categories   CardCategory[]
  description  String       @db.Text
  requirements String[]     @default([])
  downloadUrl  String
  donateUrl    String?
  price        Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("digital_assets")
}

/// Article / Blog Post table
model Article {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  excerpt   String?  @db.Text
  content   String?  @db.Text
  date      String
  readTime  String?
  author    String
  image     String?
  category  String
  likes     Int      @default(0)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

/// Team Member table
model TeamMember {
  id              String   @id @default(cuid())
  name            String
  role            String
  avatar          String?
  bio             String?  @db.Text
  experienceYears Int      @default(0)
  joinedYear      Int
  skills          String[] @default([])
  resume          Json?
  socials         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("team_members")
}
